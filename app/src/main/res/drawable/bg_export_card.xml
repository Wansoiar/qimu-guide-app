<?xml version="1.0" encoding="utf-8"?>
<!-- 导出页主卡：米白柔影无框，圆角 12；内置暖棕柔影 -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:height="24dp"
        android:gravity="bottom">
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/radius_card" />
            <gradient
                android:startColor="#0E2F1F0D"
                android:endColor="#002F1F0D"
                android:angle="270" />
        </shape>
    </item>
    <item
        android:height="10dp"
        android:gravity="bottom">
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/radius_card" />
            <gradient
                android:startColor="#142F1F0D"
                android:endColor="#002F1F0D"
                android:angle="270" />
        </shape>
    </item>
    <item
        android:left="1dp"
        android:top="0dp"
        android:right="1dp"
        android:bottom="4dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/qimu_surface" />
            <corners android:radius="@dimen/radius_card" />
        </shape>
    </item>
</layer-list>
