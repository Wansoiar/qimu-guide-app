<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_screen_warm"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/page_margin"
        android:paddingTop="24dp"
        android:paddingEnd="@dimen/page_margin"
        android:paddingBottom="36dp">

        <com.qimu.guide.ui.widget.SerifTextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/provisioning_title"
            android:textAppearance="@style/TextAppearance.Qimu.PageTitle" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:letterSpacing="0.02"
            android:lineSpacingExtra="3dp"
            android:text="@string/provisioning_subtitle"
            android:textAppearance="@style/TextAppearance.Qimu.Body" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp">

            <View
                android:layout_width="match_parent"
                android:layout_height="2dp"
                android:layout_gravity="top"
                android:layout_marginTop="15dp"
                android:layout_marginStart="44dp"
                android:layout_marginEnd="44dp"
                android:background="@color/qimu_outline" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center_horizontal"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tv_step_circle_connect"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:background="@drawable/bg_step_circle_current"
                        android:gravity="center"
                        android:text="1"
                        android:textColor="@color/qimu_surface"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tv_step_connect"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="7dp"
                        android:letterSpacing="0.06"
                        android:text="@string/provisioning_step_connect"
                        android:textColor="@color/qimu_brown"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center_horizontal"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tv_step_circle_serial"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:background="@drawable/bg_step_circle_idle"
                        android:gravity="center"
                        android:text="2"
                        android:textColor="@color/qimu_text_tertiary"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tv_step_serial"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="7dp"
                        android:letterSpacing="0.06"
                        android:text="@string/provisioning_step_phone_serial"
                        android:textColor="@color/qimu_text_tertiary"
                        android:textSize="11sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center_horizontal"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tv_step_circle_venue"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:background="@drawable/bg_step_circle_idle"
                        android:gravity="center"
                        android:text="3"
                        android:textColor="@color/qimu_text_tertiary"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tv_step_venue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="7dp"
                        android:letterSpacing="0.06"
                        android:text="@string/provisioning_step_venue"
                        android:textColor="@color/qimu_text_tertiary"
                        android:textSize="11sp" />
                </LinearLayout>
            </LinearLayout>
        </FrameLayout>

        <LinearLayout
            android:id="@+id/section_provisioning_connect"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_card_default"
            android:orientation="vertical"
            android:padding="@dimen/card_padding">

            <com.qimu.guide.ui.widget.SerifTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/provisioning_step_connect"
                android:textAppearance="@style/TextAppearance.Qimu.SectionTitle" />

            <TextView
                android:id="@+id/tv_provisioning_connection_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/provisioning_connect_first"
                android:textColor="@color/qimu_error"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_provisioning_glasses"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:lineSpacingExtra="2dp"
                android:text="@string/provisioning_no_glasses"
                android:textColor="@color/qimu_text_secondary"
                android:textSize="13sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_provisioning_scan"
                style="@style/Widget.Qimu.Button.Primary"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="18dp"
                android:letterSpacing="0.08"
                android:text="@string/scan_and_connect" />

            <TextView
                android:id="@+id/tv_provisioning_scan_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/connect_hint"
                android:textColor="@color/qimu_text_tertiary"
                android:textSize="12sp" />

            <LinearLayout
                android:id="@+id/layout_provisioning_scan_results"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:orientation="vertical" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/section_provisioning_serial"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_card_default"
            android:orientation="vertical"
            android:padding="@dimen/card_padding"
            android:visibility="gone">

            <com.qimu.guide.ui.widget.SerifTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/provisioning_step_phone_serial"
                android:textAppearance="@style/TextAppearance.Qimu.SectionTitle" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:lineSpacingExtra="2dp"
                android:text="@string/provisioning_phone_serial_hint"
                android:textColor="@color/qimu_text_secondary"
                android:textSize="12sp" />

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.Qimu.TextInputLayout.Outlined"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:layout_marginBottom="8dp"
                android:hint="@string/provisioning_phone_serial_label">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/edit_provisioning_phone_serial"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textCapCharacters|textNoSuggestions"
                    android:maxLength="64"
                    android:singleLine="true" />
            </com.google.android.material.textfield.TextInputLayout>

        </LinearLayout>

        <LinearLayout
            android:id="@+id/section_provisioning_venue"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_card_default"
            android:orientation="vertical"
            android:padding="@dimen/card_padding"
            android:visibility="gone">

            <com.qimu.guide.ui.widget.SerifTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/provisioning_step_venue"
                android:textAppearance="@style/TextAppearance.Qimu.SectionTitle" />

            <RadioGroup
                android:id="@+id/group_provisioning_venues"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="vertical" />

            <TextView
                android:id="@+id/tv_provisioning_venues_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/provisioning_venues_loading"
                android:textColor="@color/qimu_text_tertiary"
                android:textSize="12sp"
                android:visibility="gone" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_provisioning_prev"
                style="@style/Widget.Qimu.Button.Outline"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:letterSpacing="0.08"
                android:text="@string/provisioning_step_prev" />

            <Space
                android:layout_width="12dp"
                android:layout_height="1dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_provisioning_next"
                style="@style/Widget.Qimu.Button.Primary"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:letterSpacing="0.08"
                android:text="@string/provisioning_step_next"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
