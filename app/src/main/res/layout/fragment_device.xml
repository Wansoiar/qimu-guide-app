<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="12dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/device_management"
        android:textSize="20sp"
        android:textColor="@color/text_primary"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/device_subtitle"
        android:textSize="14sp"
        android:textColor="@color/text_secondary"
        android:layout_marginTop="4dp" />

    <!-- 已连接状态卡片 -->
    <LinearLayout
        android:id="@+id/layout_connected"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone"
        android:background="@drawable/card_background"
        android:padding="16dp"
        android:layout_marginTop="12dp">

        <TextView
            android:id="@+id/tv_device_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="18sp"
            android:textColor="@color/text_primary"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_device_id"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:textColor="@color/text_hint"
            android:layout_marginTop="4dp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/divider"
            android:layout_marginVertical="8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:weightSum="3">

            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/battery" android:textSize="12sp" android:textColor="@color/text_hint" />
                <TextView android:id="@+id/tv_battery" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="--" android:textSize="16sp" android:textColor="@color/text_primary" />
            </LinearLayout>
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/signal" android:textSize="12sp" android:textColor="@color/text_hint" />
                <TextView android:id="@+id/tv_signal" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="--" android:textSize="16sp" android:textColor="@color/text_primary" />
            </LinearLayout>
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/firmware_version" android:textSize="12sp" android:textColor="@color/text_hint" />
                <TextView android:id="@+id/tv_firmware" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="--" android:textSize="16sp" android:textColor="@color/text_primary" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- 未连接状态 -->
    <LinearLayout
        android:id="@+id/layout_disconnected"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="visible"
        android:layout_marginTop="12dp">

        <TextView android:id="@+id/tv_scan_status" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="@string/state_disconnected" android:textSize="14sp" android:textColor="@color/text_secondary" android:layout_marginBottom="8dp" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn_scan"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:background="@color/colorPrimary"
            android:text="@string/scan_and_connect"
            android:textColor="@android:color/white"
            android:textAllCaps="false" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn_direct_connect"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="6dp"
            android:background="@color/colorAccent"
            android:text="🔗 一键直连眼镜 (V03 Pro)"
            android:textColor="@android:color/white"
            android:textAllCaps="false" />
    </LinearLayout>

    <!-- 设备列表 -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recycler_devices"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="6dp"
        android:visibility="visible" />

    <!-- ── 调试分隔线 ── -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="━━━ 调试控制 ━━━"
        android:textSize="12sp"
        android:textColor="@color/colorPrimary"
        android:gravity="center"
        android:layout_marginTop="4dp" />

    <!-- 调试按钮行1 -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
        <Button android:id="@+id/btn_debug_disconnect" android:layout_width="0dp" android:layout_height="36dp" android:layout_weight="1" android:text="断开" android:textSize="10sp" android:textAllCaps="false" android:layout_marginEnd="1dp" />
        <Button android:id="@+id/btn_debug_query_battery" android:layout_width="0dp" android:layout_height="36dp" android:layout_weight="1" android:text="查电量" android:textSize="10sp" android:textAllCaps="false" android:layout_marginHorizontal="1dp" />
        <Button android:id="@+id/btn_debug_sync_time" android:layout_width="0dp" android:layout_height="36dp" android:layout_weight="1" android:text="同步时间" android:textSize="10sp" android:textAllCaps="false" android:layout_marginStart="1dp" />
    </LinearLayout>
    <!-- 调试按钮行2 -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="2dp">
        <Button android:id="@+id/btn_debug_query_file" android:layout_width="0dp" android:layout_height="36dp" android:layout_weight="1" android:text="查询文件" android:textSize="10sp" android:textAllCaps="false" android:layout_marginEnd="1dp" />
        <Button android:id="@+id/btn_debug_wifi_download" android:layout_width="0dp" android:layout_height="36dp" android:layout_weight="1" android:text="WiFi下载" android:textSize="10sp" android:textAllCaps="false" android:layout_marginHorizontal="1dp" />
        <Button android:id="@+id/btn_debug_a2dp" android:layout_width="0dp" android:layout_height="36dp" android:layout_weight="1" android:text="A2DP配对" android:textSize="10sp" android:textAllCaps="false" android:layout_marginStart="1dp" />
    </LinearLayout>
    <!-- 调试按钮行3 -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="2dp">
        <Button android:id="@+id/btn_debug_play_tone" android:layout_width="0dp" android:layout_height="36dp" android:layout_weight="1" android:text="播放测试音" android:textSize="10sp" android:textAllCaps="false" android:layout_marginEnd="1dp" />
        <Button android:id="@+id/btn_debug_clear_log" android:layout_width="0dp" android:layout_height="36dp" android:layout_weight="1" android:text="清日志" android:textSize="10sp" android:textAllCaps="false" android:layout_marginStart="1dp" />
    </LinearLayout>
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="120dp"
        android:layout_marginTop="4dp"
        android:background="#1A000000">

        <TextView
            android:id="@+id/tv_debug_log"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="9sp"
            android:textColor="#CC000000"
            android:padding="4dp"
            android:lineSpacingExtra="2dp"
            android:typeface="monospace" />
    </ScrollView>

</LinearLayout>
