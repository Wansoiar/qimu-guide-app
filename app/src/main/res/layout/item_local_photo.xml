<?xml version="1.0" encoding="utf-8"?>
<com.qimu.guide.ui.gallery.SquareFrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/gallery_photo_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clickable="true"
    android:focusable="true">

    <ImageView
        android:id="@+id/gallery_photo_image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_margin="2dp"
        android:background="@drawable/gallery_bg_photo_tile"
        android:clipToOutline="true"
        android:contentDescription="本机照片"
        android:scaleType="centerCrop" />

    <View
        android:id="@+id/gallery_selected_border"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/gallery_bg_selected_border"
        android:clickable="false"
        android:focusable="false"
        android:visibility="gone" />

    <CheckBox
        android:id="@+id/gallery_photo_checkbox"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_gravity="top|end"
        android:layout_margin="2dp"
        android:background="@drawable/gallery_bg_checkbox_scrim"
        android:buttonTint="@color/gallery_checkbox_tint"
        android:contentDescription="选择照片"
        android:gravity="center"
        android:padding="9dp"
        app:buttonTint="@color/gallery_checkbox_tint" />
</com.qimu.guide.ui.gallery.SquareFrameLayout>
