<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_screen_warm"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:background="@drawable/bg_app_bar"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="22dp"
        android:paddingEnd="6dp">

        <com.qimu.guide.ui.widget.SerifTextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:letterSpacing="0.05"
            android:text="@string/operator_config_title"
            android:textAppearance="@style/TextAppearance.Qimu.PageTitle"
            android:textSize="20sp" />

        <ImageButton
            android:id="@+id/btn_close_operator_config"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/close_operator_config"
            android:padding="11dp"
            android:src="@drawable/ic_close_24"
            app:tint="@color/qimu_text_secondary" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/page_margin"
            android:paddingTop="20dp"
            android:paddingEnd="@dimen/page_margin"
            android:paddingBottom="36dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:letterSpacing="0.03"
                android:lineSpacingExtra="2dp"
                android:text="@string/operator_config_subtitle"
                android:textColor="@color/qimu_text_secondary"
                android:textSize="12sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_card_accent"
                android:orientation="vertical"
                android:padding="@dimen/card_padding">

                <com.qimu.guide.ui.widget.SerifTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.06"
                    android:text="@string/operator_venue_section"
                    android:textAppearance="@style/TextAppearance.Qimu.SectionTitle"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/tv_operator_current_venue"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:fontFamily="sans-serif"
                    android:lineSpacingExtra="2dp"
                    android:textColor="@color/qimu_gold_dark"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_operator_venue_id"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:ellipsize="end"
                    android:fontFamily="monospace"
                    android:maxLines="2"
                    android:textColor="@color/qimu_text_secondary"
                    android:textSize="11sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_card_default"
                android:orientation="vertical"
                android:padding="@dimen/card_padding">

                <com.qimu.guide.ui.widget.SerifTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.06"
                    android:text="@string/operator_device_section"
                    android:textAppearance="@style/TextAppearance.Qimu.SectionTitle"
                    android:textSize="15sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:letterSpacing="0.1"
                    android:text="@string/operator_device_id"
                    android:textColor="@color/qimu_text_tertiary"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tv_operator_device_id"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:ellipsize="end"
                    android:fontFamily="monospace"
                    android:maxLines="2"
                    android:textColor="@color/qimu_text_primary"
                    android:textSize="13sp" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="14dp"
                    android:layout_marginBottom="14dp"
                    android:background="@color/qimu_outline" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.1"
                    android:text="@string/operator_phone_serial"
                    android:textColor="@color/qimu_text_tertiary"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tv_operator_phone_serial"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:ellipsize="end"
                    android:fontFamily="monospace"
                    android:maxLines="2"
                    android:textColor="@color/qimu_text_primary"
                    android:textSize="13sp" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="14dp"
                    android:layout_marginBottom="14dp"
                    android:background="@color/qimu_outline" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.1"
                    android:text="@string/operator_glasses_id"
                    android:textColor="@color/qimu_text_tertiary"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tv_operator_glasses_id"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:ellipsize="end"
                    android:fontFamily="monospace"
                    android:maxLines="2"
                    android:textColor="@color/qimu_text_primary"
                    android:textSize="13sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/layout_mock_order"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_card_soft"
                android:orientation="vertical"
                android:padding="@dimen/card_padding"
                android:visibility="gone">

                <com.qimu.guide.ui.widget.SerifTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.05"
                    android:text="@string/mock_order_title"
                    android:textAppearance="@style/TextAppearance.Qimu.SectionTitle"
                    android:textColor="@color/qimu_text_primary" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:fontFamily="monospace"
                    android:text="@string/mock_order_value"
                    android:textColor="@color/qimu_gold_dark"
                    android:textSize="24sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:lineSpacingExtra="2dp"
                    android:text="@string/mock_order_hint"
                    android:textColor="@color/qimu_text_secondary"
                    android:textSize="12sp" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_reset_device"
                style="@style/Widget.Qimu.Button.DangerOutline"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="24dp"
                android:letterSpacing="0.08"
                android:text="@string/operator_reset_button" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
