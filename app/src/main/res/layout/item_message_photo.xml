<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="end"
    android:orientation="horizontal"
    android:paddingTop="6dp"
    android:paddingBottom="6dp">

    <LinearLayout
        android:id="@+id/bubble_root"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bubble_user"
        android:orientation="vertical"
        android:padding="@dimen/bubble_padding">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="7dp"
            android:letterSpacing="0.1"
            android:text="@string/message_photo_label"
            android:textColor="@color/qimu_gold"
            android:textSize="12sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/iv_photo"
            android:layout_width="228dp"
            android:layout_height="171dp"
            android:background="@drawable/bg_photo_placeholder"
            android:clipToOutline="true"
            android:contentDescription="@string/message_photo_label"
            android:scaleType="centerCrop" />

        <TextView
            android:id="@+id/tv_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="@color/qimu_text_tertiary"
            android:textSize="11sp" />
    </LinearLayout>
</LinearLayout>
