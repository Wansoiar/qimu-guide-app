<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="start|top"
    android:orientation="horizontal"
    android:paddingTop="6dp"
    android:paddingBottom="6dp">

    <FrameLayout
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:background="@drawable/bg_brand_badge"
        android:padding="6dp">
        <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:contentDescription="@string/message_ai_label" android:src="@drawable/ic_glasses_24" app:tint="@color/qimu_gold_dark" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:background="@drawable/bubble_ai"
        android:maxWidth="300dp"
        android:orientation="vertical"
        android:padding="12dp">

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/message_ai_label" android:textColor="@color/qimu_gold_dark" android:textSize="11sp" android:textStyle="bold" />
        <TextView android:id="@+id/tv_text" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:lineSpacingExtra="3dp" android:textColor="@color/qimu_text_primary" android:textSize="15sp" />
        <TextView android:id="@+id/tv_time" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:textColor="@color/qimu_text_tertiary" android:textSize="11sp" />
    </LinearLayout>
</LinearLayout>
